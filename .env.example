# Copie este arquivo para ".env" e preencha. O .env NAO vai para o git.

# --- Cameras Yoosee ---
# Senha definida no app Yoosee (Configuracoes > Seguranca > Senha NVR/RTSP)
CAMERA1_IP=192.168.1.190
CAMERA1_SENHA=sua_senha_aqui
CAMERA1_LEGENDA=Camera 1
CAMERA1_GIRAR180=false

CAMERA2_IP=192.168.1.192
CAMERA2_SENHA=sua_senha_aqui
CAMERA2_LEGENDA=Camera 2
CAMERA2_GIRAR180=false

# --- Twitch ---
# Painel do Criador da Twitch > Configuracoes > Transmissao
TWITCH_CHAVE=live_XXXXXXXXXXXXXXXX
TWITCH_SERVIDOR=rtmp://live.twitch.tv/app

# --- Opcoes de video (opcionais) ---
# Yoosee normalmente so aceita "udp". Use "tcp" se outra camera exigir.
TRANSPORTE=udp
# "onvif1" = alta qualidade | "onvif2" = baixa qualidade (internet fraca)
QUALIDADE_CAMERA=onvif2
# Cada camera fica 960x540 -> video final 1920x540
LARGURA_CADA=960
ALTURA_CADA=540
FPS=15
# Reduza para 1500k se a internet de upload for fraca
BITRATE_VIDEO=2500k
# Usa o chip de video do Mac (Apple Silicon)
ACELERACAO_MAC=true
